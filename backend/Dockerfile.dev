FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:$PATH"

# Copy the backend source (see .dockerignore for what is excluded)
COPY . .

# Install dependencies. --no-sources ignores the local age-orm path in
# pyproject.toml, which does not exist inside the image, and installs the
# published age-orm from PyPI instead.
RUN uv sync --all-extras --no-sources

ENV PATH="/app/.venv/bin:$PATH"
ENV VIRTUAL_ENV=/app/.venv

RUN mkdir -p /app/static/frontend

EXPOSE 8000

# If the age-orm source is mounted at /age-orm, install it in editable mode
# over the PyPI version so local changes to age-orm are picked up.
CMD ["/bin/bash", "-c", "if [ -d /age-orm ]; then uv pip install -e /age-orm; fi && exec python -m fastapi dev quranref/main.py --host 0.0.0.0 --port 8000 --reload"]
